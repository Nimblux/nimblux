# ==============================================================
# NIMBLUX ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgres://username:password@hostname:5432/database?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="your_secure_jwt_signing_secret_here"

# Canonical Production Base URL (No trailing slash)
NEXT_PUBLIC_APP_URL="https://nimblux.xyz"

# --------------------------------------------------------------
# Google OAuth 2.0 Credentials
# Configure in Google Cloud Console:
# Authorized JavaScript Origins:
#   https://nimblux.xyz
#   http://localhost:3000
# Authorized Redirect URIs:
#   https://nimblux.xyz/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
# --------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
# Optional override for exact redirect URI:
# GOOGLE_REDIRECT_URI="https://nimblux.xyz/api/auth/google/callback"

# --------------------------------------------------------------
# Cloudinary Persistent Media Storage
# Server-side upload credentials (Never expose SECRET to browser)
# --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
# Or provide the single unified Cloudinary URL:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
